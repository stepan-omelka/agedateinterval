{
  "name": "agedate",
  "private": true,
  "description": "Agedate: Angular frontend (web/) + Next.js API (api/), sharing the dating-range rule (shared/)",
  "scripts": {
    "prepare": "husky",
    "postinstall": "npm --prefix api install && npm --prefix web install",
    "dev": "concurrently --kill-others-on-fail -n api,web -c gray,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix api run dev",
    "dev:web": "npm --prefix web start",
    "build": "npm --prefix api run build:site",
    "start": "npm --prefix api start",
    "lint": "npm --prefix api run lint && npm --prefix web run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm --prefix api test && npm --prefix web test -- --watch=false",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/cz-commitlint": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "commitizen": "^4.3.2",
    "concurrently": "^9.2.5",
    "husky": "^9.1.7",
    "inquirer": "^12.11.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.8.1"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
