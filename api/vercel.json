{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix ../web",
  "buildCommand": "npm run build:site",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "src/image/fonts/*.woff"
    }
  },
  "rewrites": [
    {
      "source": "/api/story/:age(1[4-9]|[2-9]\\d|1[01]\\d|120)",
      "destination": "/api/story/:age.png"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/:file([\\w-]+-[A-Z0-9]{8}\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
